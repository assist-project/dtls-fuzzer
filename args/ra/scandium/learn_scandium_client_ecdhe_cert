state-fuzzer-client

# SUT config
-port
${sul.port}
-startWait
1000
-responseWait
100
-protocol
DTLS12
-cmd
java -jar ${fuzzer.dir}/suts/scandium-${scandium.version}-dtls-clientserver.jar -client -port ${sul.port} -timeout 20000000 -trustLocation ${keystore}/ec_secp256r1.jks -trustPassword password -trustAlias dtls-fuzzer -keyLocation ${keystore}/ec_secp256r1.jks -keyPassword password -keyAlias dtls-fuzzer -clientAuth NEEDED -starterAddress localhost:${fuzzer.port}
-sulConfig
experiments/configs/scandium.config
-adapterPort
${fuzzer.port}
-processTrigger
START

# learning config
-alphabet
examples/alphabets/ra/clients/ecdhe_ecdsa_aes128_cbc_sha256.xml
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
IO_RANDOM_WALK
-output
${output.ra}/scandium-${scandium.version}_client_ecdhe_cert
-maxRuns
20000
-skipNonDetTests
