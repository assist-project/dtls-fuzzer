state-fuzzer-server

# SUT config
-connect
localhost:${sul.port}
-startWait
200
-responseWait
200
-protocol
DTLS12
-cmd
${fuzzer.dir}/suts/wolfssl-${wolfssl.version}/examples/server/server  -i -x -p ${sul.port} -s -u -l PSK-AES128-CBC-SHA256
-processDir
${fuzzer.dir}/suts/wolfssl-${wolfssl.version}/

# learning config
-alphabet
${alphabets.ra.servers}/psk_aes128_cbc_sha256.xml
-maxRuns
20000
-output
${output.ra}/wolfssl-${wolfssl.version}_server_psk
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
IO_RANDOM_WALK
-ceReruns
3
