state-fuzzer-client

# SUT config
-protocol
DTLS12
-port
${sul.port}
-startWait
0
-responseWait
100
-cmd
${fuzzer.dir}/suts/gnutls-${gnutls.version}/src/gnutls-cli --udp --heartbeat --pskusername Client_identity --pskkey 12345678 --priority NORMAL:-KX-ALL:+RSA:+ECDHE-PSK:+DHE-PSK:+PSK:+ECDHE-RSA:+DHE-RSA --x509cafile ${keystore}/rsa2048_cert.pem --x509keyfile ${keystore}/rsa2048_key.pem --x509certfile ${keystore}/rsa2048_cert.pem --insecure localhost:${sul.port}
-psk
12345678
-identity
Client_identity

# learning config
-alphabet
examples/alphabets/ra/clients/ecdhe_rsa_aes128_cbc_sha_reneg.xml
-maxRuns
20000
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
IO_RANDOM_WALK
-output
${output.ra}/gnutls-${gnutls.version}_client_ecdhe_cert_reneg
-ceReruns
3
-timeLimit
P2D
