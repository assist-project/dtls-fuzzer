state-fuzzer-server

# SUT config
-protocol
DTLS12
-connect
localhost:${sul.port}
-startWait
200
-responseWait
50
-cmd
${fuzzer.dir}/suts/openssl-${openssl.version}/apps/openssl s_server -psk 1234 -key ${keystore}/rsa2048_key.pem -cert ${keystore}/rsa2048_cert.pem -CAfile ${keystore}/rsa2048_cert.pem -Verify 1 -accept ${sul.port} -dtls1_2 -mtu 5000

# learning config
-maxRuns
20000
-output
${output.ra}/openssl-${openssl.version}_server_psk_epoch
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
IO_RANDOM_WALK
-seedTransitions
-randLength
10
-alphabet
examples/alphabets/ra/servers/psk_aes128_cbc_sha256_epoch.xml
