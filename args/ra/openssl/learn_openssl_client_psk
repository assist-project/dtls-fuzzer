state-fuzzer-client

# SUT config
-protocol
DTLS12
-port
${sul.port}
-startWait
0
-responseWait
50
-cmd
${fuzzer.dir}/suts/openssl-${openssl.version}/apps/openssl s_client -psk 1234 -key ${keystore}/rsa2048_key.pem -cert ${keystore}/rsa2048_cert.pem -CAfile ${keystore}/rsa2048_cert.pem -port ${sul.port} -dtls1_2 -mtu 5000

# learner config
-maxRuns
20000
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
IO_RANDOM_WALK
-alphabet
examples/alphabets/ra/clients/psk_aes128_cbc_sha256.xml
-output
${output.ra}/openssl-${openssl.version}_client_psk

# mapper config
-socketClosedAsTimeout
-disabledAsTimeout
